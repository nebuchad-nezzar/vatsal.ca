---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/PageHead.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { Icon } from 'astro-icon/components'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Market Commentary" />
  <Breadcrumbs
    items={[
      { label: 'Markets', href: '/markets', icon: 'lucide:line-chart' },
    ]}
  />

  <div class="mt-8 flex flex-col gap-8">
    <div class="space-y-4">
      <h1 class="text-4xl font-bold">Market Research</h1>
      <p class="text-lg text-muted-foreground">
        Select an archive below to read my macro analysis, trading insights, and economic breakdowns.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <!-- Daily Card -->
      <a href="/markets/daily" class="group flex flex-col justify-between gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:bg-accent hover:shadow-sm">
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-2xl font-semibold">
            <Icon name="lucide:calendar-days" class="size-7 text-primary" />
            <span>Daily Briefings</span>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Fast, tactical updates covering equities, yields, and breaking geopolitical events affecting the markets day-to-day.
          </p>
        </div>
        <div class="text-sm font-medium text-primary group-hover:underline mt-4 flex items-center gap-1">
          Read Daily Archive <Icon name="lucide:arrow-right" class="size-4" />
        </div>
      </a>

      <!-- Weekly Card -->
      <a href="/markets/weekly" class="group flex flex-col justify-between gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:bg-accent hover:shadow-sm">
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-2xl font-semibold">
            <Icon name="lucide:calendar-range" class="size-7 text-primary" />
            <span>Weekly Deep Dives</span>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Comprehensive structural analysis, longer-term trend identification, and strategic portfolio positioning for the week ahead.
          </p>
        </div>
        <div class="text-sm font-medium text-primary group-hover:underline mt-4 flex items-center gap-1">
          Read Weekly Archive <Icon name="lucide:arrow-right" class="size-4" />
        </div>
      </a>
    </div>
  </div>
</Layout>
