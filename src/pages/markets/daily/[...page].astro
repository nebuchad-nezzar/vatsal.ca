---
export const prerender = true
import BlogCard from '@/components/BlogCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import PaginationComponent from '@/components/ui/pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getDailyPosts, groupPostsByYear } from '@/lib/data-utils'
import type { PaginateFunction } from 'astro'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await getDailyPosts()
  return paginate(allPosts, { pageSize: SITE.postsPerPage })
}

const { page } = Astro.props

const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Daily Market Commentary" />
  <Breadcrumbs
    items={[
      { label: 'Markets', href: '/markets', icon: 'lucide:line-chart' },
      { label: 'Daily Commentary', href: '/markets/daily', icon: 'lucide:calendar-days' },
      { label: `Page ${page.currentPage}`, icon: 'lucide:book-copy' },
    ]}
  />

  <div class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-8 mt-4">
    <div class="space-y-4 mb-4">
      <h1 class="text-3xl font-bold">Daily Market Commentary</h1>
      <p class="text-muted-foreground">The complete archive of Vatsal's daily macro analysis, covering equities, fixed income, commodities, and structural shifts.</p>
    </div>

    {
      years.map((year) => (
        <section class="flex flex-col gap-y-4">
          <div class="font-medium text-lg border-b border-border pb-2">{year}</div>
          <ul class="flex flex-col gap-4">
            {postsByYear[year].map((post) => (
              <li>
                <BlogCard entry={post} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <PaginationComponent
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl="/markets/daily/"
    client:load
  />
</Layout>
