---
import Layout from '@/layouts/Layout.astro'
import Container from '@/components/Container.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import { Icon } from 'astro-icon/components'
---

<Layout>
  <PageHead 
    slot="head" 
    title="AI Integrations & Agentic Workflows | Vatsal Sharma" 
    description="Production-grade AI systems that replace manual workflows with autonomous agents."
  />

  <Container>
    <div class="py-8 space-y-16">
      <Breadcrumbs items={[
        { label: 'Services', href: '/services', icon: 'lucide:layers' },
        { label: 'AI Integrations', icon: 'lucide:bot' }
      ]} />

      <!-- Hero Section -->
      <section class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-bold">
          <span class="text-base">🤖</span>
          <span>LLM & Agent Engineering</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl font-black text-foreground uppercase tracking-tight leading-[1.1]">
          AI Integrations & <br class="hidden sm:block" /> Agentic Workflows
        </h1>
        
        <p class="text-base sm:text-xl text-muted-foreground max-w-2xl leading-relaxed">
          Production-grade AI systems that replace manual workflows with autonomous agents — retrieval, reasoning, and tool use, deployed to production with eval and monitoring.
        </p>
      </section>

      <!-- What We Build Section (Alternating Left/Right) -->
      <section class="space-y-8">
        <div class="space-y-2">
          <h2 class="text-2xl font-bold text-foreground">What We Build</h2>
          <p class="text-muted-foreground text-sm">Custom AI systems engineered for specific business workflows.</p>
        </div>

        <div class="space-y-4">
          <!-- Item 1 (Odd: Number Left, Text Right) -->
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row items-stretch">
              <!-- Number Section (Left) -->
              <div class="p-8 md:w-1/3 flex items-center justify-center border-b md:border-b-0 md:border-r border-white/10 bg-black/20">
                <span class="text-7xl font-black text-white/5 group-hover:text-primary/20 transition-colors duration-500">01</span>
              </div>
              <!-- Text Section (Right) -->
              <div class="p-8 md:w-2/3 flex flex-col justify-center space-y-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Autonomous Research & Analysis Agents</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  AI agents that continuously ingest SEC filings, earnings transcripts, news feeds, and alternative data to deliver real-time actionable signals and structured summaries.
                </p>
              </div>
            </div>
          </div>

          <!-- Item 2 (Even: Text Left, Number Right) -->
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
            <div class="relative z-10 flex flex-col-reverse md:flex-row items-stretch">
              <!-- Text Section (Left) -->
              <div class="p-8 md:w-2/3 flex flex-col justify-center space-y-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Production RAG Pipelines</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  Hybrid vector + keyword retrieval with re-ranking, chunk optimization, and strict hallucination guardrails. Designed for high-stakes domains where accuracy is non-negotiable.
                </p>
              </div>
              <!-- Number Section (Right) -->
              <div class="p-8 md:w-1/3 flex items-center justify-center border-b md:border-b-0 md:border-l border-white/10 bg-black/20">
                <span class="text-7xl font-black text-white/5 group-hover:text-primary/20 transition-colors duration-500">02</span>
              </div>
            </div>
          </div>

          <!-- Item 3 (Odd: Number Left, Text Right) -->
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row items-stretch">
              <!-- Number Section (Left) -->
              <div class="p-8 md:w-1/3 flex items-center justify-center border-b md:border-b-0 md:border-r border-white/10 bg-black/20">
                <span class="text-7xl font-black text-white/5 group-hover:text-primary/20 transition-colors duration-500">03</span>
              </div>
              <!-- Text Section (Right) -->
              <div class="p-8 md:w-2/3 flex flex-col justify-center space-y-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Model Context Protocol (MCP) Integrations</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  Connect foundation models directly to your SQL databases, CRMs, internal APIs, and document stores with structured tool-use definitions and access control.
                </p>
              </div>
            </div>
          </div>

          <!-- Item 4 (Even: Text Left, Number Right) -->
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
            <div class="relative z-10 flex flex-col-reverse md:flex-row items-stretch">
              <!-- Text Section (Left) -->
              <div class="p-8 md:w-2/3 flex flex-col justify-center space-y-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Multi-Agent Orchestration Systems</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  Coordinated agent workflows where specialized agents handle research, analysis, drafting, and validation — with human-in-the-loop checkpoints.
                </p>
              </div>
              <!-- Number Section (Right) -->
              <div class="p-8 md:w-1/3 flex items-center justify-center border-b md:border-b-0 md:border-l border-white/10 bg-black/20">
                <span class="text-7xl font-black text-white/5 group-hover:text-primary/20 transition-colors duration-500">04</span>
              </div>
            </div>
          </div>

          <!-- Item 5 (Odd: Number Left, Text Right) -->
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row items-stretch">
              <!-- Number Section (Left) -->
              <div class="p-8 md:w-1/3 flex items-center justify-center border-b md:border-b-0 md:border-r border-white/10 bg-black/20">
                <span class="text-7xl font-black text-white/5 group-hover:text-primary/20 transition-colors duration-500">05</span>
              </div>
              <!-- Text Section (Right) -->
              <div class="p-8 md:w-2/3 flex flex-col justify-center space-y-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">AI Evaluation & Monitoring</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  CI/CD eval harnesses with regression test suites, cost-per-request tracking, quality drift detection, latency monitoring, and automated model comparison.
                </p>
              </div>
            </div>
          </div>

          <!-- Item 6 (Even: Text Left, Number Right) -->
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
            <div class="relative z-10 flex flex-col-reverse md:flex-row items-stretch">
              <!-- Text Section (Left) -->
              <div class="p-8 md:w-2/3 flex flex-col justify-center space-y-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Voice & Conversational AI</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  Production voice agents and chat interfaces for customer support, intake processes, and internal operations — with real-time transcription and intent routing.
                </p>
              </div>
              <!-- Number Section (Right) -->
              <div class="p-8 md:w-1/3 flex items-center justify-center border-b md:border-b-0 md:border-l border-white/10 bg-black/20">
                <span class="text-7xl font-black text-white/5 group-hover:text-primary/20 transition-colors duration-500">06</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Technologies -->
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-foreground">Technologies & Frameworks</h2>
        <div class="flex flex-wrap gap-2">
          {['OpenAI', 'Anthropic Claude', 'Google Gemini', 'LangChain', 'LlamaIndex', 'Pinecone', 'Weaviate', 'pgvector', 'FastAPI', 'Next.js', 'WebSocket', 'Docker'].map(tech => (
            <span class="px-3 py-1 text-xs font-bold border border-border rounded-full bg-background text-foreground">
              {tech}
            </span>
          ))}
        </div>
      </section>

      <!-- Fit / Not Fit -->
      <section class="grid md:grid-cols-2 gap-8">
        <div class="space-y-4 p-6 rounded-xl border border-border bg-background">
          <div class="flex items-center gap-2 mb-4 text-green-500">
            <Icon name="lucide:check-circle" class="w-5 h-5 text-green-500" />
            <h3 class="font-bold text-green-500">Good Fit For</h3>
          </div>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-green-500 mt-0.5">•</span>
              <span>Teams with a specific workflow they want to automate with AI — not a vague "we want to use AI" initiative</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500 mt-0.5">•</span>
              <span>Companies with existing data (documents, databases, APIs) that AI agents need to connect to</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500 mt-0.5">•</span>
              <span>Firms that need production reliability, not a hackathon demo — eval, monitoring, and error handling from day one</span>
            </li>
          </ul>
        </div>
        
        <div class="space-y-4 p-6 rounded-xl border border-border bg-background">
          <div class="flex items-center gap-2 mb-4 text-red-500">
            <Icon name="lucide:x-circle" class="w-5 h-5 text-red-500" />
            <h3 class="font-bold text-red-500">Not a Fit For</h3>
          </div>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">•</span>
              <span>Companies looking for off-the-shelf chatbot SaaS — we build custom, not configure vendor products</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">•</span>
              <span>Teams without budget or willingness to provide real data for testing and evaluation</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">•</span>
              <span>Projects where the primary need is prompt engineering without any system integration</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- How Engagement Works -->
      <section class="space-y-8">
        <div class="space-y-2">
          <h2 class="text-2xl font-bold text-foreground">How the Engagement Works</h2>
          <p class="text-muted-foreground text-sm">A structured process to move from prototype to production.</p>
        </div>

        <div class="relative space-y-8 before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-white/10">
          
          <!-- Step 1 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group/timeline">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-[#0a0a0a] text-primary font-bold shrink-0 md:order-1 md:group-odd/timeline:-translate-x-1/2 md:group-even/timeline:translate-x-1/2 shadow-sm z-10">1</div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20 p-6">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
              <div class="relative z-10">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="font-bold text-foreground group-hover:text-primary transition-colors">Workflow Discovery</h3>
                  <span class="text-xs text-muted-foreground px-2 py-0.5 rounded bg-white/5 border border-white/10">Days 1-5</span>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">Map the manual workflow end-to-end. Identify data sources, decision points, error modes, and success criteria. Define the eval dataset.</p>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group/timeline">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-[#0a0a0a] text-primary font-bold shrink-0 md:order-1 md:group-odd/timeline:-translate-x-1/2 md:group-even/timeline:translate-x-1/2 shadow-sm z-10">2</div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20 p-6">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
              <div class="relative z-10">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="font-bold text-foreground group-hover:text-primary transition-colors">Architecture & Model Selection</h3>
                  <span class="text-xs text-muted-foreground px-2 py-0.5 rounded bg-white/5 border border-white/10">Week 2</span>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">Select foundation models, design retrieval strategy, define tool schemas, and architect the agent graph. Cost and latency projections.</p>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group/timeline">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-[#0a0a0a] text-primary font-bold shrink-0 md:order-1 md:group-odd/timeline:-translate-x-1/2 md:group-even/timeline:translate-x-1/2 shadow-sm z-10">3</div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20 p-6">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
              <div class="relative z-10">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="font-bold text-foreground group-hover:text-primary transition-colors">Agent Build Sprint</h3>
                  <span class="text-xs text-muted-foreground px-2 py-0.5 rounded bg-white/5 border border-white/10">Weeks 3-6</span>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">Core agent development with weekly demos. Each agent tested against the eval set. Guardrails, error handling, and fallback paths built in.</p>
              </div>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group/timeline">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-[#0a0a0a] text-primary font-bold shrink-0 md:order-1 md:group-odd/timeline:-translate-x-1/2 md:group-even/timeline:translate-x-1/2 shadow-sm z-10">4</div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20 p-6">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
              <div class="relative z-10">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="font-bold text-foreground group-hover:text-primary transition-colors">Integration & Testing</h3>
                  <span class="text-xs text-muted-foreground px-2 py-0.5 rounded bg-white/5 border border-white/10">Weeks 7-8</span>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">Connect to production data sources. End-to-end testing with real data. Load testing and failure mode validation.</p>
              </div>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group/timeline">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-[#0a0a0a] text-primary font-bold shrink-0 md:order-1 md:group-odd/timeline:-translate-x-1/2 md:group-even/timeline:translate-x-1/2 shadow-sm z-10">5</div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] group relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20 p-6">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
              <div class="relative z-10">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="font-bold text-foreground group-hover:text-primary transition-colors">Deployment & Monitoring</h3>
                  <span class="text-xs text-muted-foreground px-2 py-0.5 rounded bg-white/5 border border-white/10">Weeks 9-10</span>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">Production deployment with observability dashboards, cost tracking, quality alerts, and runbook documentation.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Card -->
      
      <!-- CTA -->
      <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#0a0a0a] transition-all duration-500 hover:scale-[1.01] hover:shadow-xl hover:border-white/20 p-8 sm:p-10 text-center mt-16">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-purple-900/10 to-transparent opacity-100 pointer-events-none"></div>
        <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
        <div class="relative z-10 space-y-4 flex flex-col items-center justify-center">
          <h3 class="text-xl sm:text-2xl font-bold text-foreground">
          Move from AI demo to AI in production.
        </h3>
        <p class="text-sm text-muted-foreground max-w-lg mx-auto">
          We build autonomous AI agents and RAG systems for technology-driven firms. Tell us about your workflow.
        </p>
        <a href="/book-a-call" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white text-[#0a0a0a] hover:bg-white/90 text-xs font-bold transition-all">
          Book an Appointment →
        </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>
