---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Newsletter Blast Control</h1>

    <div class="bg-white shadow sm:rounded-lg mb-8">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Authentication</h3>
        <div class="mt-2 max-w-xl text-sm text-gray-500">
          <p>Please enter your newsletter secret to preview and send.</p>
        </div>
        <form id="auth-form" class="mt-5 sm:flex sm:items-center">
          <div class="w-full sm:max-w-xs">
            <label for="secret" class="sr-only">Secret</label>
            <input type="password" name="secret" id="secret" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border" placeholder="Enter secret key">
          </div>
          <button type="submit" class="mt-3 w-full inline-flex items-center justify-center px-4 py-2 border border-transparent shadow-sm font-medium rounded-md text-white bg-black hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
            Load Preview
          </button>
        </form>
      </div>
    </div>

    <div id="preview-section" class="hidden">
      <div class="bg-white shadow sm:rounded-lg mb-8">
        <div class="px-4 py-5 sm:p-6 flex justify-between items-center">
          <div>
            <h3 class="text-lg leading-6 font-medium text-gray-900">Email Preview</h3>
            <p class="mt-1 text-sm text-gray-500">This is exactly what will be blasted to the readers.</p>
          </div>
          <button id="send-btn" class="inline-flex items-center justify-center px-6 py-3 border border-transparent shadow-sm text-base font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
            BLAST TO READERS
          </button>
        </div>
        <div class="border-t border-gray-200">
          <iframe id="preview-frame" class="w-full h-[800px] border-0" src="about:blank"></iframe>
        </div>
      </div>
    </div>

    <div id="status-message" class="hidden rounded-md p-4 mb-8">
      <p class="text-sm font-medium" id="status-text"></p>
    </div>
  </div>
</Layout>

<script>
  let currentSecret = '';

  const authForm = document.getElementById('auth-form') as HTMLFormElement;
  const secretInput = document.getElementById('secret') as HTMLInputElement;
  const previewSection = document.getElementById('preview-section');
  const previewFrame = document.getElementById('preview-frame') as HTMLIFrameElement;
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
  const statusMessage = document.getElementById('status-message');
  const statusText = document.getElementById('status-text');

  function showStatus(message: string, isError = false) {
    if (!statusMessage || !statusText) return;
    statusMessage.className = `rounded-md p-4 mb-8 ${isError ? 'bg-red-50 text-red-800' : 'bg-green-50 text-green-800'}`;
    statusText.textContent = message;
    statusMessage.classList.remove('hidden');
  }

  authForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    currentSecret = secretInput.value;
    
    // Load the preview in the iframe
    if (previewFrame && previewSection) {
      previewFrame.src = `/api/newsletter/send-digest?test=true&secret=${encodeURIComponent(currentSecret)}`;
      previewSection.classList.remove('hidden');
      
      // Hide any previous status
      if (statusMessage) statusMessage.classList.add('hidden');
    }
  });

  sendBtn?.addEventListener('click', async () => {
    if (!currentSecret) return;
    
    const confirmBlast = confirm("Are you absolutely sure you want to blast this email to all subscribers? Please verify the preview below first.");
    if (!confirmBlast) return;

    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';

    try {
      // Must be a POST request to send
      const response = await fetch(`/api/newsletter/send-digest?confirm=yes&secret=${encodeURIComponent(currentSecret)}`, {
        method: 'POST'
      });
      
      const data = await response.json();
      
      if (response.ok) {
        showStatus(`Success! ${data.message || 'Newsletter sent to all subscribers.'}`);
        sendBtn.textContent = 'SENT';
        sendBtn.classList.replace('bg-red-600', 'bg-gray-400');
        sendBtn.classList.replace('hover:bg-red-700', 'hover:bg-gray-400');
      } else {
        showStatus(`Error: ${data.error || 'Failed to send'}. ${data.message || ''}`, true);
        sendBtn.disabled = false;
        sendBtn.textContent = 'BLAST TO READERS';
      }
    } catch (err: any) {
      showStatus(`Network Error: ${err.message}`, true);
      sendBtn.disabled = false;
      sendBtn.textContent = 'BLAST TO READERS';
    }
  });
</script>
