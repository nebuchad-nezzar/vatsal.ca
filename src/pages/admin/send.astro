---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-foreground mb-8">Newsletter Blast Control</h1>

    <!-- Auth Card -->
    <div class="relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] text-foreground p-6 shadow-sm mb-8">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 via-purple-900/5 to-transparent opacity-100 pointer-events-none"></div>
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none"></div>
      
      <div class="relative z-10">
        <h3 class="text-lg font-bold text-foreground mb-4">Authentication</h3>
        
        <form id="auth-form" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-xl">
          <div class="w-full sm:max-w-xs">
            <label for="secret" class="sr-only">Secret</label>
            <input 
              type="password" 
              name="secret" 
              id="secret" 
              class="w-full bg-white/5 border border-white/10 text-foreground placeholder:text-muted-foreground rounded-lg py-2.5 px-4 text-sm focus:outline-none focus:border-white/30 transition-colors" 
              placeholder="Enter secret key"
            >
          </div>
          <button 
            type="submit" 
            class="inline-flex items-center justify-center px-5 py-2.5 border border-transparent font-bold rounded-lg text-sm text-[#0a0a0a] bg-white hover:bg-gray-200 transition-colors cursor-pointer shrink-0"
          >
            Load Preview
          </button>
        </form>
      </div>
    </div>

    <!-- Preview Section -->
    <div id="preview-section" class="hidden">
      <div class="relative overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] text-foreground shadow-sm mb-8">
        <div class="p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h3 class="text-lg font-bold text-foreground">Email Preview</h3>
            <p class="text-sm text-muted-foreground mt-0.5">This is exactly what will be blasted to the readers.</p>
          </div>
          <button 
            id="send-btn" 
            class="inline-flex items-center justify-center px-6 py-3 border border-transparent font-bold rounded-lg text-sm text-white bg-red-600 hover:bg-red-700 transition-colors cursor-pointer shrink-0"
          >
            BLAST TO READERS
          </button>
        </div>
        <div class="border-t border-white/10 bg-white">
          <iframe id="preview-frame" class="w-full h-[850px] border-0" src="about:blank"></iframe>
        </div>
      </div>
    </div>

    <!-- Status Message -->
    <div id="status-message" class="hidden rounded-xl p-4 mb-8 border">
      <p class="text-sm font-medium" id="status-text"></p>
    </div>
  </div>
</Layout>

<script>
  let currentSecret = '';

  const authForm = document.getElementById('auth-form') as HTMLFormElement;
  const secretInput = document.getElementById('secret') as HTMLInputElement;
  const previewSection = document.getElementById('preview-section');
  const previewFrame = document.getElementById('preview-frame') as HTMLIFrameElement;
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
  const statusMessage = document.getElementById('status-message');
  const statusText = document.getElementById('status-text');

  function showStatus(message: string, isError = false) {
    if (!statusMessage || !statusText) return;
    statusMessage.className = `rounded-xl p-4 mb-8 border ${isError ? 'bg-red-950/40 border-red-800/50 text-red-200' : 'bg-emerald-950/40 border-emerald-800/50 text-emerald-200'}`;
    statusText.textContent = message;
    statusMessage.classList.remove('hidden');
  }

  authForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    currentSecret = secretInput.value;
    
    // Load the preview in the iframe
    if (previewFrame && previewSection) {
      previewFrame.src = `/api/newsletter/send-digest?test=true&secret=${encodeURIComponent(currentSecret)}`;
      previewSection.classList.remove('hidden');
      
      // Hide any previous status
      if (statusMessage) statusMessage.classList.add('hidden');
    }
  });

  sendBtn?.addEventListener('click', async () => {
    if (!currentSecret) return;
    
    const confirmBlast = confirm("Are you absolutely sure you want to blast this email to all subscribers? Please verify the preview below first.");
    if (!confirmBlast) return;

    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';

    try {
      // Must be a POST request to send
      const response = await fetch(`/api/newsletter/send-digest?confirm=yes&secret=${encodeURIComponent(currentSecret)}`, {
        method: 'POST'
      });
      
      const data = await response.json();
      
      if (response.ok) {
        showStatus(`Success! ${data.message || 'Newsletter sent to all subscribers.'}`);
        sendBtn.textContent = 'SENT';
        sendBtn.classList.replace('bg-red-600', 'bg-gray-600');
        sendBtn.classList.replace('hover:bg-red-700', 'hover:bg-gray-600');
      } else {
        showStatus(`Error: ${data.error || 'Failed to send'}. ${data.message || ''}`, true);
        sendBtn.disabled = false;
        sendBtn.textContent = 'BLAST TO READERS';
      }
    } catch (err: any) {
      showStatus(`Network Error: ${err.message}`, true);
      sendBtn.disabled = false;
      sendBtn.textContent = 'BLAST TO READERS';
    }
  });
</script>
