---
export const prerender = true
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import MarketTreemap from '@/components/react/MarketTreemap'
import AdvancedChart from '@/components/react/AdvancedChart'
import TopMovers from '@/components/react/TopMovers'
import VolumeLeaders from '@/components/react/VolumeLeaders'
import HighsLows from '@/components/react/HighsLows'
import EconomicCalendar from '@/components/react/EconomicCalendar'
import MarketDataTable from '@/components/react/MarketDataTable'
import EconomicMap from '@/components/react/EconomicMap'
import ForexHeatmap from '@/components/react/ForexHeatmap'
import CryptoHeatmap from '@/components/react/CryptoHeatmap'
---

<Layout class="px-2">
  <PageHead slot="head" title="Markets" />

  <div class="max-w-7xl mx-auto pt-4 pb-6 space-y-12">
    <!-- Page Header -->
    <div class="text-center space-y-4">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight">
        Financial Markets
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Real-time market data, interactive charts, and comprehensive analysis
      </p>
    </div>

    <!-- Market Commentary Archives -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href="/markets/daily" class="bg-card border border-border p-6 rounded-xl hover:border-primary/50 transition-colors group flex items-center justify-between">
        <div class="text-left space-y-1.5">
          <h3 class="text-lg font-bold group-hover:text-primary transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/80"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
            Daily Market Commentary
          </h3>
          <p class="text-sm text-muted-foreground">Read the daily macro analysis and market recap archive.</p>
        </div>
        <span class="text-primary group-hover:translate-x-1 transition-transform">→</span>
      </a>
      <a href="/markets/weekly" class="bg-card border border-border p-6 rounded-xl hover:border-primary/50 transition-colors group flex items-center justify-between">
        <div class="text-left space-y-1.5">
          <h3 class="text-lg font-bold group-hover:text-primary transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/80"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            Weekly Macro Briefing
          </h3>
          <p class="text-sm text-muted-foreground">Deep dives into weekly trends and structural alpha.</p>
        </div>
        <span class="text-primary group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <!-- Economic Map Section -->
    <section>
      <EconomicMap client:load />
    </section>

    <!-- Market Data Tables Section (Stacked) -->
    <section class="space-y-16">
      <MarketDataTable category="indices" client:load />
      <MarketDataTable category="stocks" client:load />
      <MarketDataTable category="currencies" client:load />
      <MarketDataTable category="crypto" client:load />
    </section>

    <!-- Top Movers Section -->
    <section>
      <TopMovers client:load />
    </section>

    <!-- Volume & Highs/Lows Grid -->
    <section class="grid lg:grid-cols-2 gap-8">
      <VolumeLeaders client:load />
      <div class="space-y-8">
        <HighsLows type="highs" client:load />
      </div>
    </section>

    <!-- Market Performance
    <section>
      <MarketPerformance client:load />
    </section> -->
    <!-- Market Heatmap Section (Stacked) -->
    <section class="space-y-16">
      <MarketTreemap market="sp500" client:load />
      <MarketTreemap market="nasdaq" client:load />
      <ForexHeatmap client:load />
      <CryptoHeatmap client:load />
    </section>

    <!-- Advanced Chart Section -->
    <section>
      <AdvancedChart client:load />
    </section>

    <!-- Economic Calendar Section -->
    <section>
      <EconomicCalendar client:load />
    </section>


    

    <!-- Additional Info -->
    <!-- <section class="border-t border-border pt-8">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="space-y-2">
          <h3 class="text-lg font-semibold">Real-Time Data</h3>
          <p class="text-sm text-muted-foreground">
            Access live market data from global exchanges with minimal delay
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="text-lg font-semibold">Interactive Charts</h3>
          <p class="text-sm text-muted-foreground">
            Analyze price movements with professional-grade charting tools and indicators
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="text-lg font-semibold">Multiple Markets</h3>
          <p class="text-sm text-muted-foreground">
            Track stocks, indices, commodities, forex, crypto, and more in one place
          </p>
        </div>
      </div>
    </section> -->
  </div>
</Layout>

<style>
  /* Ensure TradingView widgets render properly */
  :global(.tradingview-widget-container) {
    position: relative;
  }
  
  :global(.tradingview-widget-container iframe) {
    border-radius: inherit;
  }
</style>
