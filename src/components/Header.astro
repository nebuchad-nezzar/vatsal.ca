---
import Link from '@/components/Link.astro'
import { Image } from 'astro:assets'
import logo from '../assets/logo.webp'
import WorkDropdown from '@/components/react/WorkDropdown'
---

<header transition:persist>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0">
      <Image src={logo} alt="Logo" class="size-14 sm:size-14" />
    </Link>
    <div class="flex items-center gap-4">
      <nav class="flex items-center gap-6 text-sm">
        <Link
          href="/blog"
          class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors"
        >
          Blogs
        </Link>

        <Link
          href="/markets"
          class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors"
        >
          Markets
        </Link>

        <WorkDropdown client:load />

        <Link
          href="/about"
          class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors"
        >
          About
        </Link>

        <Link 
          href="/book-a-call" 
          class="px-3 py-1 border border-border/60 hover:border-primary/50 hover:bg-primary/5 transition-all text-xs font-mono tracking-widest text-foreground/80 uppercase"
        >
          Book a call
        </Link>
      </nav>
    </div>
  </div>
</header>
