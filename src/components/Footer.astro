---
import { SOCIAL_LINKS, NAV_LINKS } from '@/consts'
import Link from '@/components/Link.astro'
import Newsletter from './react/Newsletter'
import { Icon } from 'astro-icon/components'
import logo from '../assets/logo.webp'
---

<footer class="bg-background/80 border-t border-border/50 backdrop-blur-md">
  <div class="mx-auto max-w-4xl px-4 py-8 sm:py-10">
    <div class="flex flex-col gap-8">
      <!-- Newsletter Section -->
      <div class="grid lg:grid-cols-[1fr_1.3fr] gap-8 py-6 md:py-8 items-center border-b border-border/20 pb-8">
        <div class="text-left space-y-2">
          <div class="flex items-center gap-2 mb-2">
            <Icon name="lucide:mail" class="size-5 text-primary shrink-0" />
            <h3 class="text-xl font-bold tracking-tight text-foreground">Join the Newsletter</h3>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Read by business leaders navigating market volatility. Subscribe to get VWAP, The Daily Alpha Pulse, and my latest technical and research blogs delivered directly to your inbox.
          </p>
        </div>
        <div class="w-full flex flex-col items-start gap-3">
          <Newsletter client:load />
          
          <!-- Google News Trusted Source Pill Badge (Sleek Compact & Flush Left) -->
          <div class="w-full flex justify-start pt-1">
            <a
              href="https://news.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex max-w-full flex-wrap items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900/90 border border-slate-800 text-[11px] font-medium text-slate-300 hover:text-white hover:border-slate-700 transition-all shadow-xs group"
            >
              <span>Add</span>
              <img src="/favicon-96x96.png" alt="Vatsal Sharma Logo" class="h-3.5 w-3.5 inline-block object-contain group-hover:scale-110 transition-transform" />
              <span>as a Trusted source on</span>
              <svg class="size-3.5 shrink-0" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <span>Google News</span>
            </a>
          </div>
        </div>
      </div>



      <!-- Main Footer Content (Simplified Grid) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-12 gap-y-8 font-mono pt-4 border-t border-border/20">
        <!-- Website -->
        <div class="space-y-4">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-foreground/40">Website</h4>
          <nav class="flex flex-col gap-2">
            {NAV_LINKS.map((item) => (
              <Link href={item.href} class="text-xs text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider">
                {item.label}
              </Link>
            ))}
          </nav>
        </div>

        <!-- Connect -->
        <div class="space-y-4">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-foreground/40">Connect</h4>
          <nav class="flex flex-col gap-2">
            <Link href="mailto:vatswork10@gmail.com" class="text-xs text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider">
              Email
            </Link>
            <Link href="/book-a-call" class="text-xs text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider">
              Call
            </Link>
          </nav>
        </div>

        <!-- Social -->
        <div class="space-y-4">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-foreground/40">Social</h4>
          <nav class="flex flex-col gap-2">
            {SOCIAL_LINKS.map((item) => (
              <Link href={item.href} class="text-xs text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider">
                {item.label}
              </Link>
            ))}
          </nav>
        </div>

        <!-- Legal -->
        <div class="space-y-4">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-foreground/40">Legal</h4>
          <nav class="flex flex-col gap-2">
            <Link href="/privacy" class="text-xs text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider">
              Privacy
            </Link>
            <Link href="/terms" class="text-xs text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider">
              Terms
            </Link>
          </nav>
        </div>
      </div>

      <div class="pt-8 text-[10px] text-muted-foreground/30 font-mono uppercase tracking-[0.3em] flex justify-between items-center">
        <span>Vatsal Sharma &copy; {new Date().getFullYear()}</span>
        <img src={logo.src} width={logo.width} height={logo.height} alt="Logo" class="size-6 opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all" />
      </div>
    </div>
  </div>
</footer>
