---
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<span
  class:list={[
    'inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider',
    'bg-primary/15 text-primary border border-primary/30 rounded',
    className,
  ]}
>
  <svg class="size-2.5" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
  </svg>
  Premium
</span>
