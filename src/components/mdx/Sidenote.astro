---
import { cn } from '@/lib/utils'

interface Props {
  number?: string | number
  class?: string
}

const { number = "1", class: className } = Astro.props

// Generate a unique ID for this sidenote so the JS engine can link the marker to the content
const id = `sidenote-${Math.random().toString(36).substr(2, 9)}`
---

<span class={cn("sidenote-wrapper", className)}>
  {/* Inline marker for desktop/JS engine */}
  <button
    class="sidenote-marker"
    data-sidenote-ref={id}
    aria-label={`Sidenote ${number}`}
  >
    {number}
  </button>
  
  {/* Template holding the rich content (images/gifs/text) for the JS engine to extract */}
  <template id={`template-${id}`}>
    <div class="sidenote-content-inner">
      <span class="sidenote-number">{number}</span>
      <slot />
    </div>
  </template>

  {/* Mobile fallback (CSS only inline toggle) */}
  <input type="checkbox" id={`mobile-sidenote-${id}`} class="mobile-sidenote-checkbox sr-only" />
  <label for={`mobile-sidenote-${id}`} class="mobile-sidenote-toggle sr-only">Toggle Sidenote {number}</label>
  <aside class="mobile-sidenote-content">
    <span class="sidenote-number">{number}</span>
    <slot />
  </aside>
</span>

<style>
  .sidenote-wrapper {
    display: inline;
  }

  /* Inline marker */
  .sidenote-marker {
    display: inline;
    cursor: pointer;
    font-size: 0.65em;
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-variant-numeric: oldstyle-nums;
    vertical-align: super;
    line-height: 0;
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: none;
    padding: 0 0.2em;
    margin: 0 0.1em;
    border-radius: 0.25rem;
    transition: all 0.2s ease;
  }

  .sidenote-marker:hover, .sidenote-marker.lit {
    color: hsl(var(--foreground));
    background-color: hsl(var(--muted) / 0.5);
  }

  .sidenote-marker.pinned {
    color: hsl(var(--primary-foreground));
    background-color: hsl(var(--primary));
  }

  .sidenote-number {
    font-size: 0.7em;
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-variant-numeric: oldstyle-nums;
    vertical-align: super;
    line-height: 0;
    margin-right: 0.35em;
    color: inherit;
  }

  /* Mobile Inline Toggle */
  .mobile-sidenote-content {
    display: none;
  }

  @media (max-width: 1023px) {
    .sidenote-marker {
      pointer-events: none; /* Let the label handle clicks on mobile */
    }
    
    .mobile-sidenote-toggle {
      display: inline-block;
      position: absolute;
      width: 1.5em;
      height: 1.5em;
      margin-left: -1.5em;
      cursor: pointer;
      z-index: 10;
    }
    .mobile-sidenote-toggle:not(.sr-only) {
      position: absolute; /* fallback */
    }

    .mobile-sidenote-checkbox:checked ~ .mobile-sidenote-content {
      display: block;
      margin: 0.75rem 0;
      padding: 0.75rem 1rem;
      border-left: 2px solid hsl(var(--muted));
      background: transparent;
      font-size: 0.8rem;
      line-height: 1.55;
      font-family: inherit;
      font-style: italic;
      color: hsl(var(--muted-foreground));
    }
  }
</style>
