---
import SubscribeModal from '@/components/react/SubscribeModal'
---

<div class="premium-paywall-card-container">
  <div class="premium-paywall-fade"></div>
  <div class="flex flex-col items-center justify-center text-center px-6 py-10 relative z-10">
    <div class="border border-border/60 rounded-2xl p-8 max-w-md w-full shadow-2xl premium-card-bg">
      <!-- Lock icon with glow -->
      <div class="mx-auto mb-5 flex size-14 items-center justify-center rounded-full bg-primary/10 border border-primary/20 shadow-[0_0_20px_rgba(var(--primary),0.15)]">
        <svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>

      <h3 class="text-lg font-bold text-foreground mb-1.5 tracking-tight">
        This post is for subscribers
      </h3>
      <p class="text-muted-foreground text-sm mb-6 max-w-xs mx-auto leading-relaxed">
        Subscribe to get full access to premium research, market analysis, and deep dives.
      </p>

      <!-- Subscribe CTA -->
      <a
        href="/subscribe"
        class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-primary text-primary-foreground font-semibold text-sm rounded-lg hover:brightness-110 transition-all duration-200 w-full shadow-lg shadow-primary/20"
      >
        Subscribe
      </a>

      <p class="text-muted-foreground/60 text-xs mt-5">
        Already a subscriber? <a href="#" class="text-primary/80 hover:text-primary hover:underline transition-colors">Sign in</a>
      </p>
    </div>
  </div>
</div>

<SubscribeModal client:load />

<style>
  .premium-paywall-card-container {
    position: relative;
  }
  /* Smooth gradient from transparent to background — bridges the blur into the card */
  .premium-paywall-fade {
    position: absolute;
    top: -80px;
    left: -2rem;
    right: -2rem;
    height: 120px;
    background: linear-gradient(to bottom, transparent 0%, var(--background) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .premium-card-bg {
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--secondary) 90%, var(--primary) 10%) 0%,
      var(--secondary) 100%
    );
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('premium-paywall-subscribe-btn')
    if (btn) {
      btn.addEventListener('click', () => {
        const event = new CustomEvent('open-subscribe-modal')
        window.dispatchEvent(event)
      })
    }
  })
</script>
